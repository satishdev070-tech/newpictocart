# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (Project Settings -> API) ---
# Full URL: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). Safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Secret key (sb_secret_...). SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Upstash Redis (optional storefront L2 cache) ---
# Console → Redis → REST API. Leave blank locally; production uses free-tier Upstash near Mumbai.
# Both must be set together. Public storefront reads only (never cart/session/dashboard).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 32+ random chars (openssl rand -base64 48). SERVER ONLY. Required: signs cart/session tokens
# and encrypts stored credentials. Never rotate casually.
APP_SECRET=
# 24+ random chars. Vercel Cron sends it as "Authorization: Bearer ..." to /api/cron/*.
CRON_SECRET=

# --- Platform ---
# HOSTNAME format (no scheme, port or path; a pasted https://www.x.in/ is reduced to x.in). Stores are served at {slug}.{root}; {root} and
# www.{root} serve the platform. For local dev use "localhost" and open http://acme.localhost:3000
NEXT_PUBLIC_PLATFORM_ROOT_DOMAIN=localhost
# FULL URL format (https://host, no path). Where the platform app lives: links in emails, OAuth
# callbacks, and its host is ALSO served as the platform. Leave blank locally (defaults from the
# root domain). On Vercel before the real domain is attached: https://your-project.vercel.app
NEXT_PUBLIC_PLATFORM_URL=
# Optional, HOSTNAME format, comma-separated: extra exact hosts that serve the platform app
# (e.g. a second Vercel alias). Exact match only; wildcards are rejected.
# Vercel's own *.vercel.app URLs (VERCEL_URL, VERCEL_BRANCH_URL, VERCEL_PROJECT_PRODUCTION_URL)
# are trusted automatically.
PLATFORM_HOST_ALIASES=

# --- Email (Resend) — or set the key in Admin → Email ---
# re_... API key with sending access, and a From address on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Build Brighten <no-reply@mail.buildbrighten.in>"
# Supabase → Authentication → Hooks → "Send Email" (HTTPS) → secret (v1,whsec_...). With it set,
# every auth email (confirm, reset, magic link, invite) is sent through Resend by
# https://{platform root}/api/auth/email-hook. See docs/EMAIL.md.
SEND_EMAIL_HOOK_SECRET=

# --- Edge (Cloudflare domain-router Worker) ---
# 32+ random chars shared with the Worker to sign forwarded hostnames. Leave blank until the Worker is deployed.
EDGE_SHARED_SECRET=

# debug | info | warn | error
LOG_LEVEL=info

# --- Observability (login spans + Performance Center ingest) ---
# Master switch for sampled request telemetry. Unset = off at info; true = emit; false = force off.
# OBSERVABILITY_ENABLED=true
# When 1 (and master is not false), login-path obs.span lines log at info even if master unset.
# OBSERVABILITY_LOGIN_SPANS=1

# --- Cloudflare Workers canary (vinext) ---
# Bare hostname of the workers.dev deploy so the proxy treats it as a platform host.
# WORKERS_DEV_HOST=pictocart.your-account.workers.dev
# CLOUDFLARE_WORKERS_HOST=pictocart.your-account.workers.dev
# Optional full URL (host extracted):
# CF_PAGES_URL=https://pictocart.your-account.workers.dev

# --- Super admin bootstrap (pnpm admin:bootstrap) ---
# Used once to create the platform super admin. Never commit real values; remove the password
# from the environment after the first sign-in.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_INITIAL_PASSWORD=

# --- Social OAuth apps (platform-level; sellers connect their own accounts) ---
# Leave blank to show "Not configured" for that network. Redirect URI to register with each
# provider: https://{platform root}/api/oauth/{provider}/callback
META_APP_ID=
META_APP_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional: social webhooks and Neural Pulse AI (or set them in Admin → Social apps)
META_WEBHOOK_VERIFY_TOKEN=
GEMINI_API_KEY=
GROQ_API_KEY=
# NVIDIA NIM (build.nvidia.com) key for Nemotron models; the console key (Admin → Social apps) wins.
NVIDIA_API_KEY=
ANTHROPIC_API_KEY=

# Optional: Sarvam AI (dashboard.sarvam.ai). SERVER ONLY. Speech-to-text, chat, TTS, translate
# for voice onboarding. Leave blank until voice flows are enabled.
SARVAM_API_KEY=
# Client flag for the start path Voice card. Unset or false = Coming Soon (quiz preferred).
# NEXT_PUBLIC_VOICE_ONBOARDING_ENABLED=false
# Informational Website in /start quiz and settings. Unset or false = ecommerce-only for new flows.
# NEXT_PUBLIC_INFORMATIVE_SITES_ENABLED=false

# Optional: Unsplash API "Access Key" (unsplash.com/developers -> your app). SERVER ONLY. Picks a
# photo per business category for marketing sections (theme cards); results are cached for a day.
# Leave blank to use the curated built-in photos (src/lib/unsplash.ts).
UNSPLASH_ACCESS_KEY=

# Optional: custom domains. Cloudflare for SaaS custom hostnames (API token with Custom Hostnames
# edit on the platform zone) and the CNAME target sellers point their domain at.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CUSTOM_DOMAIN_CNAME_TARGET=
# Optional: legacy Vercel domain API (rollback target only).
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Optional: Meta Graph API version override (defaults in code).
META_GRAPH_VERSION=
# Optional: shared header secret for seller AI Supabase Edge Functions (x-seller-ai-invoke).
# Set the same value with `supabase secrets set AI_EDGE_INVOKE_SECRET=…`.
AI_EDGE_INVOKE_SECRET=
