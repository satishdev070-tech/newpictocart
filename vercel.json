{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm build",
  "ignoreCommand": "exit 1",
  "regions": [
    "bom1"
  ],
  "crons": [
    {
      "path": "/api/cron/social-publish",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/expire-orders",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/domains",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/gbp-reviews",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/notifications",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/observability",
      "schedule": "0 0 * * *"
    }
  ]
}
